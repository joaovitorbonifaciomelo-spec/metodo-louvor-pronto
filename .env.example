# Supabase — Project Settings → API (https://app.supabase.com/project/_/settings/api)
NEXT_PUBLIC_SUPABASE_URL=

# Chave pública do client. O Supabase está migrando o nome dessa chave —
# use a que aparecer no seu painel (Settings → API → "Publishable key" ou,
# em projetos mais antigos, "anon public"). O app aceita qualquer uma das duas
# variáveis abaixo (PUBLISHABLE_KEY tem prioridade se ambas existirem):
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Chave secreta/service role — NUNCA expor no client. Usada por scripts locais
# de servidor (scripts/seed-dev.ts, scripts/import-songs-csv.ts) E pelo webhook
# de pagamento (src/app/api/webhooks/kiwify/route.ts), que precisa ignorar RLS
# porque não há sessão de usuário numa chamada servidor-a-servidor.
SUPABASE_SERVICE_ROLE_KEY=

# URL pública do deploy de produção (usada em links/redirects gerados no servidor).
# Em dev, pode deixar em branco — o app usa window.location.origin no client.
NEXT_PUBLIC_SITE_URL=

# Enriquecimento de catálogo via YouTube Data API (scripts/enrich-youtube.ts).
# Server-only — NUNCA prefixar com NEXT_PUBLIC_. Obtenha em
# https://console.cloud.google.com/apis/credentials (ative "YouTube Data API v3").
YOUTUBE_API_KEY=

# Nome do produto (permite trocar sem mexer no código)
NEXT_PUBLIC_PRODUCT_NAME="Louvor Pronto"
NEXT_PUBLIC_PRODUCT_TAGLINE="Copiloto de Repertório"

# Billing — Kiwify (ver README seção "Billing"). Sem plano Free/trial: o SaaS
# só libera acesso com assinatura ativa (ou role=admin / ambiente de dev).
# URL do checkout já criado na Kiwify (deixe em branco até existir — nunca
# inventamos uma URL de checkout).
KIWIFY_CHECKOUT_URL=
# Token do webhook cadastrado na Kiwify (Apps → Webhooks). Sem isto, o
# endpoint /api/webhooks/kiwify rejeita toda requisição por segurança.
# CONFIRMADO por inspeção real: a Kiwify chama a URL com "?signature=<hex>",
# não "?token=..." — e ainda não sabemos como essa signature é calculada nem
# se tem relação com este Token. Por isso configurar esta variável ainda NÃO
# liga a verificação real (ver src/lib/billing/kiwify.ts) — mantenha
# KIWIFY_WEBHOOK_INSPECT=true até confirmarmos o mecanismo.
KIWIFY_WEBHOOK_TOKEN=
# Modo de inspeção TEMPORÁRIO — "true" só durante o teste real do webhook na
# Kiwify (botão "Testar Webhook"). Registra headers/query/body completos em
# webhook_events para descobrir onde o token realmente vem (a documentação
# pública da Kiwify não especifica isso). NUNCA concede acesso a assinatura
# nenhuma enquanto ativo. Deixe em branco/"false" e REMOVA depois do teste —
# não deixar ligado em produção além da janela do teste.
KIWIFY_WEBHOOK_INSPECT=
# Link do portal oficial da Kiwify para o assinante gerenciar/cancelar a
# própria assinatura (opcional — usado na página /assinar quando o pagamento
# está atrasado).
KIWIFY_CUSTOMER_PORTAL_URL=
# Dias de tolerância após um aviso de cobrança atrasada (subscription_late)
# antes de cortar o acesso. Vazio = padrão do código (3 dias).
KIWIFY_PAST_DUE_GRACE_DAYS=
# ID do produto Louvor Pronto na Kiwify (Product.product_id no payload do
# webhook) — só esse produto pode alterar assinaturas neste app, mesmo que a
# conta Kiwify tenha outros produtos. NUNCA usar o product_id de um payload de
# TESTE aqui — use o ID real do produto de produção. Sem esta variável
# configurada, o webhook falha fechado: nenhum evento libera/altera acesso.
KIWIFY_PRODUCT_ID=

# Credenciais da API pública da Kiwify (OAuth) — usadas SÓ pelo utilitário
# local scripts/kiwify-find-product.ts (`npm run kiwify:find-product`), para
# descobrir o product_id real do Louvor Pronto. Não são usadas pelo app em
# produção. Gere em: Kiwify → Apps → API → "Criar API Key" (o client_secret
# só aparece uma vez, na criação — copie na hora).
KIWIFY_API_CLIENT_ID=
KIWIFY_API_CLIENT_SECRET=
KIWIFY_API_ACCOUNT_ID=
