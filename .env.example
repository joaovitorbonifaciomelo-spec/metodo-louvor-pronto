# Supabase — obtenha em https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Chave de serviço — NUNCA expor no client. Usada só em rotas admin/servidor (import CSV, stats).
SUPABASE_SERVICE_ROLE_KEY=

# Nome do produto (permite trocar sem mexer no código)
NEXT_PUBLIC_PRODUCT_NAME="Louvor Pronto"
NEXT_PUBLIC_PRODUCT_TAGLINE="Copiloto de Repertório"

# Billing (opcional — deixe em branco no MVP; ver README seção "Billing")
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PRICE_ID_PRO=
